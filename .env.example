# Monica: the instance's address and an API token (Settings → API).
MONICA_BASE_URL=https://app.monicahq.com
MONICA_API_TOKEN=
# bearer (default), apiKey, or legacy (then MONICA_USER_TOKEN too)
MONICA_TOKEN_TYPE=bearer
MONICA_USER_TOKEN=

# stdio (default) or http
MCP_TRANSPORT=stdio
# http only:
PORT=8080
MCP_BEARER_TOKEN=
# optional OAuth 2.1 login for http (e.g. Authentik, Keycloak)
MCP_OAUTH_ISSUER=
MCP_OAUTH_CANONICAL_URL=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_JWKS_URI=
