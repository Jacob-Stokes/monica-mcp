{
  "name": "monica-crm-mcp",
  "version": "2.0.0",
  "description": "MCP server for Monica, the personal CRM (version 4): contacts, notes, activities, reminders and more, for any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "monica-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "monica",
    "crm",
    "personal-crm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacob-Stokes/monica-mcp.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "jose": "^6.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
